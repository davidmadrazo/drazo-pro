#!/usr/bin/env bash
# Doctor de Drazo Pro: «drazo-doctor» en la terminal Bash de Claude (Mac, o Git Bash en Windows).
# Claude Code pone la carpeta bin/ del plugin en el PATH de esa terminal mientras el plugin está activo.
raiz="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
case "$(uname -s)" in
    Darwin) exec bash "$raiz/scripts/drazo-doctor.sh" "$@" ;;
    MINGW*|MSYS*|CYGWIN*) exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$raiz/scripts/drazo-doctor.ps1")" "$@" ;;
    *) echo "Drazo funciona en Windows y macOS; este equipo es $(uname -s)."; exit 3 ;;
esac
